{
  "name": "@ghostiq/runner",
  "version": "0.2.0",
  "private": true,
  "description": "GhostIQ runner agent: drives Playwright where the app under test is reachable.",
  "type": "module",
  "bin": {
    "ghostiq": "./dist/cli.js",
    "ghostiq-agent": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "browsers:install": "playwright install chromium"
  },
  "dependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@ghostiq/core": "workspace:*",
    "@ghostiq/personas": "workspace:*",
    "@ghostiq/shared": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "commander": "^15.0.0",
    "dotenv": "^18.0.8",
    "playwright": "^1.64.1",
    "socket.io-client": "^4.8.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "tsx": "^4.23.15"
  }
}
