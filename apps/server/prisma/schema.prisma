// GhostIQ data model. Phase 0 keeps the prototype schema; Phase 1-4 add
// LlmCall, Persona, Finding, HealEvent, ConsoleEvent, ApiKey and User.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Project {
  id             String           @id @default(uuid())
  name           String
  createdAt      DateTime         @default(now())
  githubRepo     String?
  githubPrNumber Int?
  /// Read-only for anonymous visitors (the public demo project).
  public         Boolean          @default(false)
  sessions       TestSession[]
  endpoints      EndpointHealth[]
  findings       Finding[]
  members        Membership[]
  apiKeys        ApiKey[]
}

/// A person who signed in (GitHub) or the bootstrap admin.
model User {
  id          String        @id @default(uuid())
  githubId    Int?          @unique
  login       String        @unique
  name        String?
  avatarUrl   String?
  /// Admins can see and manage every project.
  admin       Boolean       @default(false)
  createdAt   DateTime      @default(now())
  lastLoginAt DateTime?
  memberships Membership[]
  sessions    AuthSession[]
}

model Membership {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// owner: everything incl. keys and members; member: runs, triage, heals; viewer: read only.
  role      String   @default("member")
  createdAt DateTime @default(now())

  @@id([userId, projectId])
}

/// Dashboard login. The cookie holds a random token; only its SHA-256 is stored.
model AuthSession {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
  ip        String?
  userAgent String?

  @@index([userId])
}

/// Project-scoped key for runners, the CLI and CI. Shown once; only its SHA-256 is stored.
model ApiKey {
  id          String    @id @default(uuid())
  projectId   String
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name        String
  /// First characters, to recognise a key in the UI ("gq_3f9a…").
  prefix      String
  hash        String    @unique
  createdById String?
  createdAt   DateTime  @default(now())
  lastUsedAt  DateTime?
  revokedAt   DateTime?

  @@index([projectId])
}

/// Who did what. Security-relevant actions only (logins, keys, members, runs, triage, ...).
model AuditLog {
  id           String   @id @default(uuid())
  projectId    String?
  actorType    String // user, api_key, admin_token, local, anonymous, system
  actorId      String?
  actorLabel   String
  action       String // e.g. auth.login, api_key.create, run.start, finding.triage
  target       String?
  metadataJson String?
  ip           String?
  createdAt    DateTime @default(now())

  @@index([projectId, createdAt])
  @@index([createdAt])
}

model TestSession {
  id             String              @id @default(uuid())
  projectId      String
  project        Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name           String
  targetUrl      String
  /// Persona display name (kept for history even if the persona is later deleted).
  persona        String
  personaId      String?
  /// PersonaSpec JSON as used by this run (personas can change later; replay/export need this).
  personaJson    String?
  /// Seed for generated inputs, pacing and behaviors: same persona + seed = same choices.
  seed           Int?
  /// explore = planner-driven run; replay = deterministic re-run of `replayOfId`'s action log.
  mode           String              @default("explore")
  replayOfId     String?
  status         String // PENDING, RUNNING, PASSED, FAILED, CANCELLED
  goal           String?
  /// RunConfig JSON: budgets, allowed origins, destructive-action permission.
  configJson     String?
  /// Why the run ended: goal_met, goal_not_met, budget_steps, loop_detected, cancelled, ...
  endReason      String?
  summary        String?
  /// FinalState JSON when the goal was met: URL and headings (exported tests assert these).
  finalStateJson String?
  /// Playwright trace (open with `npx playwright show-trace <file>`).
  traceUrl       String?
  isBaseline     Boolean             @default(false)
  flakinessScore Float               @default(0.0)
  startedAt      DateTime            @default(now())
  endedAt        DateTime?
  steps          TestStep[]
  llmCalls       LlmCall[]
  occurrences    FindingOccurrence[]

  @@index([projectId, startedAt])
  @@index([replayOfId])
}

/// A locator repaired during replay. Pending heals are not trusted: only approved ones are
/// written into exported specs. Rejected ones count towards the false-heal rate.
model HealEvent {
  id               String    @id @default(uuid())
  projectId        String
  /// The replay run where the heal happened.
  sessionId        String
  /// The recorded run being replayed (whose locator was healed).
  sourceSessionId  String
  stepNumber       Int
  /// ElementLocator JSON before and after.
  oldLocatorJson   String
  newLocatorJson   String
  method           String // fuzzy, llm
  confidence       Float
  reason           String
  status           String    @default("pending") // pending, approved, rejected
  beforeScreenshot String?
  afterScreenshot  String?
  createdAt        DateTime  @default(now())
  decidedAt        DateTime?

  @@index([projectId, status])
  @@index([sourceSessionId])
}

/// A deduplicated defect. Raw step issues from many steps, runs and personas fold into one
/// Finding by fingerprint (type + route + rule/normalized message) within a project.
model Finding {
  id             String              @id @default(uuid())
  projectId      String
  project        Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  fingerprint    String
  type           String // see FINDING_TYPES in @ghostiq/shared
  severity       String // critical, high, medium, low, info
  title          String
  /// Route template, e.g. /api/products/:id, or * for site-wide findings.
  route          String
  /// Oracle rule: axe rule id, header name, stack-trace, ...
  rule           String?
  message        String
  /// confirmed = deterministic oracle; suspected = heuristic, needs a human look.
  confidence     String              @default("confirmed")
  status         String              @default("open") // open, confirmed, dismissed, fixed
  triageNote     String?
  recurrences    Int                 @default(1)
  /// Latest evidence: step, screenshot, request, console lines, detail.
  evidenceJson   String
  /// Steps that led to the first occurrence.
  reproJson      String
  /// Persona names that hit this finding.
  personasJson   String
  firstSessionId String
  lastSessionId  String
  firstSeenAt    DateTime            @default(now())
  lastSeenAt     DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  occurrences    FindingOccurrence[]

  @@unique([projectId, fingerprint])
  @@index([projectId, status])
}

model FindingOccurrence {
  id         String      @id @default(uuid())
  findingId  String
  finding    Finding     @relation(fields: [findingId], references: [id], onDelete: Cascade)
  sessionId  String
  session    TestSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  stepNumber Int?
  persona    String
  createdAt  DateTime    @default(now())

  @@index([sessionId])
}

/// Reference screenshot of a page for visual regression, taken from a baseline run.
model BaselineImage {
  id        String   @id @default(uuid())
  projectId String
  /// Route + screenshot size, e.g. "/cart|1280x720".
  pageKey   String
  path      String
  sessionId String
  createdAt DateTime @default(now())

  @@unique([projectId, pageKey])
}

/// A custom persona created in the dashboard. Built-in and file-based personas are not stored here.
model Persona {
  id          String   @id
  name        String
  description String
  /// The YAML source as written by the user (validated against PersonaSpec on save).
  yaml        String
  version     Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// One physical LLM provider call (including retries, repairs and cache hits).
model LlmCall {
  id           String       @id @default(uuid())
  sessionId    String?
  session      TestSession? @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  purpose      String // plan-step, heal-selector, diagnostics, health-check
  provider     String
  model        String
  attempt      String // initial, retry, repair
  ok           Boolean
  errorKind    String?
  errorMessage String?
  tokensIn     Int
  tokensOut    Int
  latencyMs    Int
  costUsd      Float? // null when the model has no known price
  cacheHit     Boolean
  fallbackUsed Boolean
  createdAt    DateTime     @default(now())

  @@index([sessionId])
  @@index([createdAt])
}

model TestStep {
  id              String           @id @default(uuid())
  sessionId       String
  session         TestSession      @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  stepNumber      Int
  action          String // GOTO, CLICK, FILL, SELECT, PRESS, HOVER, SCROLL, GO_BACK, NAVIGATE, WAIT
  description     String
  /// Durable locator code, e.g. page.getByRole("button", { name: "Sign In" })
  selector        String?
  /// Typed value; secrets are masked by the runner.
  value           String?
  status          String // PASSED, FAILED, SKIPPED
  error           String?
  screenshotPath  String?
  a11yViolations  String? // JSON list of a11y violations found
  /// The validated AgentAction the planner chose (JSON).
  actionJson      String?
  /// ElementLocator JSON: snapshot ref, role, accessible name, locator code.
  locatorJson     String?
  url             String?
  durationMs      Int?
  observationHash String?
  /// StepIssue[] JSON: console/page errors, failed requests, blocked actions. Never fatal.
  issuesJson      String?
  /// For generated fills: { strategy, kind, field } (feeds the validation oracle).
  inputJson       String?
  /// Persona behavior that injected this step (double_click, refresh_mid_flow, ...), if any.
  behavior        String?
  /// Replay: the target was found by the heal ladder rather than its recorded locator.
  healed          Boolean          @default(false)
  timestamp       DateTime         @default(now())
  networkLogs     NetworkRequest[]

  @@index([sessionId, stepNumber])
}

model NetworkRequest {
  id        String   @id @default(uuid())
  stepId    String
  step      TestStep @relation(fields: [stepId], references: [id], onDelete: Cascade)
  url       String
  method    String
  status    Int
  latencyMs Int
  timestamp DateTime @default(now())
}

model EndpointHealth {
  id           String   @id @default(uuid())
  projectId    String
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  url          String
  method       String
  callCount    Int      @default(0)
  errorCount   Int      @default(0)
  avgLatencyMs Float    @default(0.0)
  lastCalled   DateTime @default(now())

  @@unique([projectId, url, method])
}
