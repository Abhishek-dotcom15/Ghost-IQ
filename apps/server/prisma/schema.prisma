// GhostIQ data model. Phase 0 keeps the prototype schema; Phase 1-4 add
// LlmCall, Persona, Finding, HealEvent, ConsoleEvent, ApiKey and User.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Project {
  id             String           @id @default(uuid())
  name           String
  createdAt      DateTime         @default(now())
  githubRepo     String?
  githubPrNumber Int?
  sessions       TestSession[]
  endpoints      EndpointHealth[]
}

model TestSession {
  id             String     @id @default(uuid())
  projectId      String
  project        Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name           String
  targetUrl      String
  /// Persona display name (kept for history even if the persona is later deleted).
  persona        String
  personaId      String?
  /// Seed for generated inputs, pacing and behaviors: same persona + seed = same choices.
  seed           Int?
  status         String // PENDING, RUNNING, PASSED, FAILED, CANCELLED
  goal           String?
  /// RunConfig JSON: budgets, allowed origins, destructive-action permission.
  configJson     String?
  /// Why the run ended: goal_met, goal_not_met, budget_steps, loop_detected, cancelled, ...
  endReason      String?
  summary        String?
  /// Playwright trace (open with `npx playwright show-trace <file>`).
  traceUrl       String?
  isBaseline     Boolean    @default(false)
  flakinessScore Float      @default(0.0)
  startedAt      DateTime   @default(now())
  endedAt        DateTime?
  steps          TestStep[]
  llmCalls       LlmCall[]

  @@index([projectId, startedAt])
}

/// A custom persona created in the dashboard. Built-in and file-based personas are not stored here.
model Persona {
  id          String   @id
  name        String
  description String
  /// The YAML source as written by the user (validated against PersonaSpec on save).
  yaml        String
  version     Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// One physical LLM provider call (including retries, repairs and cache hits).
model LlmCall {
  id           String       @id @default(uuid())
  sessionId    String?
  session      TestSession? @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  purpose      String // plan-step, heal-selector, diagnostics, health-check
  provider     String
  model        String
  attempt      String // initial, retry, repair
  ok           Boolean
  errorKind    String?
  errorMessage String?
  tokensIn     Int
  tokensOut    Int
  latencyMs    Int
  costUsd      Float? // null when the model has no known price
  cacheHit     Boolean
  fallbackUsed Boolean
  createdAt    DateTime     @default(now())

  @@index([sessionId])
  @@index([createdAt])
}

model TestStep {
  id              String           @id @default(uuid())
  sessionId       String
  session         TestSession      @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  stepNumber      Int
  action          String // GOTO, CLICK, FILL, SELECT, PRESS, HOVER, SCROLL, GO_BACK, NAVIGATE, WAIT
  description     String
  /// Durable locator code, e.g. page.getByRole("button", { name: "Sign In" })
  selector        String?
  /// Typed value; secrets are masked by the runner.
  value           String?
  status          String // PASSED, FAILED, SKIPPED
  error           String?
  screenshotPath  String?
  a11yViolations  String? // JSON list of a11y violations found
  /// The validated AgentAction the planner chose (JSON).
  actionJson      String?
  /// ElementLocator JSON: snapshot ref, role, accessible name, locator code.
  locatorJson     String?
  url             String?
  durationMs      Int?
  observationHash String?
  /// StepIssue[] JSON: console/page errors, failed requests, blocked actions. Never fatal.
  issuesJson      String?
  /// Persona behavior that injected this step (double_click, refresh_mid_flow, ...), if any.
  behavior        String?
  timestamp       DateTime         @default(now())
  networkLogs     NetworkRequest[]

  @@index([sessionId, stepNumber])
}

model NetworkRequest {
  id        String   @id @default(uuid())
  stepId    String
  step      TestStep @relation(fields: [stepId], references: [id], onDelete: Cascade)
  url       String
  method    String
  status    Int
  latencyMs Int
  timestamp DateTime @default(now())
}

model EndpointHealth {
  id           String   @id @default(uuid())
  projectId    String
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  url          String
  method       String
  callCount    Int      @default(0)
  errorCount   Int      @default(0)
  avgLatencyMs Float    @default(0.0)
  lastCalled   DateTime @default(now())

  @@unique([projectId, url, method])
}
