{
  "name": "@ghostiq/server",
  "version": "0.2.0",
  "private": true,
  "description": "GhostIQ control plane: REST API, Socket.IO hub, persistence and AI orchestration.",
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "dev": "prisma generate && tsx watch --clear-screen=false src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "prisma generate && tsc --noEmit",
    "test": "prisma generate && vitest run",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "tsx src/seed.ts",
    "db:setup": "prisma generate && prisma db push && tsx src/seed.ts"
  },
  "dependencies": {
    "@ghostiq/llm": "workspace:*",
    "@ghostiq/personas": "workspace:*",
    "@ghostiq/shared": "workspace:*",
    "@prisma/adapter-better-sqlite3": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "pixelmatch": "^8.0.0",
    "pngjs": "^7.0.0",
    "socket.io": "^4.8.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/pngjs": "^6.0.5",
    "@types/supertest": "^7.2.1",
    "prisma": "^7.10.1",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15"
  }
}
