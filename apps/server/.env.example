# Copy to apps/server/.env and adjust. Every value has a working default.

PORT=3001
DATABASE_URL=file:./data/ghostiq.db

# Browser origins allowed to call the API (comma-separated). Not needed when the
# server serves the dashboard itself (production image).
GHOSTIQ_CORS_ORIGINS=http://localhost:5173

# ---------------------------------------------------------------------------- LLM
# Provider: gemini | claude | openai | ollama | mock
# Leave unset with no key to run in demo mode (scripted, no AI, clearly labelled).
# Leave unset with GEMINI_API_KEY present to use Gemini.
GHOSTIQ_LLM_PROVIDER=

# Model ID. Defaults: gemini -> gemini-3.5-flash-lite, claude -> claude-haiku-5-5.
# Required for openai and ollama. Check deprecation pages before pinning:
#   https://ai.google.dev/gemini-api/docs/deprecations
GHOSTIQ_LLM_MODEL=

# Key for the primary provider. Provider-native names below also work.
GHOSTIQ_LLM_API_KEY=
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Custom endpoint, e.g. http://localhost:11434/v1 for Ollama or any OpenAI-compatible server.
# GHOSTIQ_LLM_BASE_URL=

# Providers to try, in order, when the primary fails, e.g. "claude,mock" or
# "claude:claude-sonnet-5-5,ollama:llama3.2". Fallback keys come from the native key variables.
# GHOSTIQ_LLM_FALLBACK=

# GHOSTIQ_LLM_TIMEOUT_MS=60000
# GHOSTIQ_LLM_MAX_RETRIES=2

# Exit at boot when the model health check fails (recommended in CI).
# GHOSTIQ_LLM_STRICT=false

# Record real model exchanges once, then replay them offline (tests, demos).
# GHOSTIQ_LLM_RECORD_MODE=off   # off | record | replay
# GHOSTIQ_LLM_FIXTURES_DIR=fixtures/llm

# USD per 1M tokens for models missing from the built-in price table.
# GHOSTIQ_LLM_PRICE_INPUT=
# GHOSTIQ_LLM_PRICE_OUTPUT=
