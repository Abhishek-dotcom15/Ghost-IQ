{
  "name": "@ghostiq/core",
  "version": "0.4.0",
  "private": true,
  "description": "GhostIQ agent core: observe-plan-act loop, guardrails and budgets, independent of the browser driver.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@ghostiq/shared": "workspace:*"
  }
}
