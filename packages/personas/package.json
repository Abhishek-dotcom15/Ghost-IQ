{
  "name": "@ghostiq/personas",
  "version": "0.5.0",
  "private": true,
  "description": "Persona specs as data: YAML loader with line-numbered errors, built-in personas, seeded input generators, device and network profiles.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "builtin"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@ghostiq/shared": "workspace:*",
    "yaml": "^2.9.1"
  }
}
